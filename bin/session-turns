#!/usr/bin/env python3
"""Normalize AI coding-tool session transcripts into a common stream of user turns.

Emits, oldest first:

    --- [<tool> <ISO-8601 minute>]
    <user turn text>

Every reader is best-effort: unreadable files, unknown line shapes, and absent
tools are skipped rather than raised. Per-tool counts go to stderr so a caller
can distinguish "no signal" from "reader broken".
"""

import argparse
import json
import os
import re
import sys
import time
from pathlib import Path

MAX_TURN_CHARS = 800


def home(env_var, default):
    """Session root for a tool, overridable for tests."""
    return Path(os.environ.get(env_var, os.path.expanduser(default)))


def read_lines(path):
    """Yield parsed JSON objects from a JSONL file, skipping bad lines."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    yield json.loads(line)
                except (ValueError, TypeError):
                    continue
    except OSError:
        return


def text_from_content(content):
    """Claude/Codex content is a string or a list of typed blocks."""
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    parts = []
    for block in content:
        if not isinstance(block, dict):
            continue
        if block.get("type") in ("text", "input_text", "output_text"):
            parts.append(block.get("text", ""))
    return " ".join(p for p in parts if p)


# Claude Code records harness plumbing with role "user": skill bodies loaded by
# the Skill tool, background system reminders, and slash-command expansions.
# None of it is something the user said, so none of it is learnable signal.
CLAUDE_INJECTED_PREFIXES = (
    "Base directory for this skill:",
    "<system-reminder>",
    "<command-name>",
    "<command-message>",
    "<local-command-stdout>",
)


def read_claude(root, project, cutoff):
    slug = str(project).replace("/", "-")
    session_dir = root / "projects" / slug
    if not session_dir.is_dir():
        return
    for path in sorted(session_dir.glob("*.jsonl")):
        if path.name == "history.jsonl":
            continue
        if path.stat().st_mtime < cutoff:
            continue
        stamp = path.stat().st_mtime
        for obj in read_lines(path):
            message = obj.get("message", obj)
            if not isinstance(message, dict) or message.get("role") != "user":
                continue
            text = text_from_content(message.get("content", "")).strip()
            if text and not text.startswith(CLAUDE_INJECTED_PREFIXES):
                yield stamp, text


INJECTED_PREFIXES = ("<user_instructions>", "<environment_context>")


def read_codex(root, project, cutoff):
    session_dir = root / "sessions"
    if not session_dir.is_dir():
        return
    for path in sorted(session_dir.rglob("rollout-*.jsonl")):
        if path.stat().st_mtime < cutoff:
            continue
        stamp = path.stat().st_mtime
        for obj in read_lines(path):
            payload = obj.get("payload")
            if not isinstance(payload, dict):
                continue
            kind = obj.get("type")

            if kind == "session_meta":
                session_cwd = payload.get("cwd")
                if session_cwd and Path(session_cwd) != project:
                    break
                continue

            text = ""
            if kind == "event_msg" and payload.get("type") == "user_message":
                text = payload.get("message", "")
            elif (kind == "response_item"
                  and payload.get("type") == "message"
                  and payload.get("role") == "user"):
                text = text_from_content(payload.get("content", ""))

            text = text.strip()
            if text and not text.startswith(INJECTED_PREFIXES):
                yield stamp, text


def kimi_wire_files(root, session_dir):
    """Wire logs for one Kimi session, newest layout first.

    Current versions write agents/main/wire.jsonl; older ones wrote
    wire.jsonl at the session root. Subagent logs under agents/<other>/
    are deliberately skipped — their prompts come from the agent, not the user.
    """
    # Fixtures use a SESSIONS/ placeholder so they stay machine-independent.
    if session_dir.startswith("SESSIONS/"):
        base = root / "sessions" / session_dir[len("SESSIONS/"):]
    else:
        base = Path(session_dir)
    return [base / "agents" / "main" / "wire.jsonl", base / "wire.jsonl"]


def kimi_turn(obj):
    """(timestamp_or_None, text) for a user turn, or None for anything else.

    Two wire protocols are in the wild:
      current — {"type": "turn.prompt", "input": [...], "origin": {"kind": "user"}, "time": <ms>}
      legacy  — {"timestamp": <s>, "message": {"type": "TurnBegin", "payload": {"user_input": ...}}}
    """
    if obj.get("type") == "turn.prompt":
        origin = obj.get("origin")
        if isinstance(origin, dict) and origin.get("kind") != "user":
            return None
        text = text_from_content(obj.get("input", "")).strip()
        if not text:
            return None
        stamp = obj.get("time")
        # `time` is milliseconds; `timestamp` on the legacy shape is seconds.
        return (stamp / 1000 if isinstance(stamp, (int, float)) else None), text

    message = obj.get("message")
    if isinstance(message, dict) and message.get("type") == "TurnBegin":
        payload = message.get("payload")
        if not isinstance(payload, dict):
            return None
        text = str(payload.get("user_input", "")).strip()
        if not text:
            return None
        stamp = obj.get("timestamp")
        return (stamp if isinstance(stamp, (int, float)) else None), text

    return None


def read_kimi(root, project, cutoff):
    index = root / "session_index.jsonl"
    if not index.is_file():
        return
    for entry in read_lines(index):
        work_dir = entry.get("workDir")
        session_dir = entry.get("sessionDir")
        if not work_dir or not session_dir:
            continue
        if Path(work_dir) != project:
            continue
        for path in kimi_wire_files(root, session_dir):
            if not path.is_file():
                continue
            for obj in read_lines(path):
                turn = kimi_turn(obj)
                if turn is None:
                    continue
                stamp, text = turn
                if stamp is None:
                    stamp = path.stat().st_mtime
                if stamp < cutoff:
                    continue
                yield stamp, text
            # Only the first layout that exists is authoritative; reading both
            # would double every turn in a session that has been migrated.
            break


READERS = {"claude": read_claude, "codex": read_codex, "kimi": read_kimi}


def parse_since(value):
    match = re.fullmatch(r"(\d+)([dh])", value)
    if not match:
        raise argparse.ArgumentTypeError("--since must look like 7d or 12h")
    amount = int(match.group(1))
    seconds = amount * (86400 if match.group(2) == "d" else 3600)
    return time.time() - seconds


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--tool", default="auto",
                        choices=["auto"] + sorted(READERS))
    parser.add_argument("--since", default="1d", type=parse_since)
    parser.add_argument("--project", default=os.getcwd())
    parser.add_argument("--max-sessions", type=int, default=15)
    args = parser.parse_args()

    project = Path(args.project).resolve()
    tools = sorted(READERS) if args.tool == "auto" else [args.tool]

    kimi_root = home("SL_KIMI_HOME", "~/.kimi-code")
    if not kimi_root.is_dir():
        legacy = Path(os.path.expanduser("~/.kimi"))
        if legacy.is_dir():
            kimi_root = legacy

    roots = {
        "claude": home("SL_CLAUDE_HOME", "~/.claude"),
        "codex": home("SL_CODEX_HOME", "~/.codex"),
        "kimi": kimi_root,
    }

    turns = []
    for tool in tools:
        root = roots[tool]
        if not root.is_dir():
            print(f"{tool}: not installed", file=sys.stderr)
            continue
        found = list(READERS[tool](root, project, args.since))
        print(f"{tool}: {len(found)} user turns", file=sys.stderr)
        turns.extend((stamp, tool, text) for stamp, text in found)

    turns.sort(key=lambda item: item[0])
    for stamp, tool, text in turns:
        when = time.strftime("%Y-%m-%dT%H:%M", time.localtime(stamp))
        print(f"--- [{tool} {when}]")
        print(text[:MAX_TURN_CHARS])


if __name__ == "__main__":
    main()
